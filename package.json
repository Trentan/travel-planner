{
  "name": "travel-planner",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:browser": "node tests/browser-suite.js",
    "test:browser:headed": "node tests/browser-suite.js --headed --slowmo=400",
    "build:css": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js",
    "prepare:capacitor-web": "node scripts/prepare-capacitor-web.js",
    "build:mobile": "npm run build:css && npm run prepare:capacitor-web && npx cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.54.0",
    "postcss": "^8.5.15",
    "puppeteer": "^25.0.2",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2"
  }
}
